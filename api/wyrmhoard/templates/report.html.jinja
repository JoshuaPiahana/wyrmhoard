<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ household_name }} — Money Meeting, {{ generated_fmt }}</title>
<style>
  /* Self-contained on purpose: no fonts to fetch, no CDN, no JavaScript.
     This file should still open correctly from a USB stick in ten years. */
  :root{
    --ink:#1f2421; --ink-soft:#4a5450; --ink-faint:#7b8783;
    --paper:#fbf9f5; --card:#ffffff; --line:#e4ded3;
    --good:#2f6f4e; --good-bg:#e8f2ec;
    --warn:#9a6414; --warn-bg:#fbf1de;
    --bad:#9c3a2e; --bad-bg:#f9e9e6;
    --accent:#2c5f5a; --accent-bg:#e6efee;
  }
  *{box-sizing:border-box}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font:16px/1.6 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .sheet{max-width:820px; margin:0 auto; padding:48px 32px 96px}
  section{margin:0 0 56px}
  h1,h2,h3{line-height:1.25; margin:0 0 12px; font-weight:650}
  h1{font-size:34px; letter-spacing:-.02em}
  h2{font-size:23px; letter-spacing:-.01em; margin-top:0}
  h3{font-size:17px}
  p{margin:0 0 14px; color:var(--ink-soft)}
  .lede{font-size:17px; color:var(--ink-soft)}
  .eyebrow{
    font-size:12px; text-transform:uppercase; letter-spacing:.11em;
    color:var(--ink-faint); font-weight:600; margin-bottom:8px;
  }

  /* ---- cover ---- */
  header.cover{
    border-bottom:2px solid var(--ink); padding-bottom:28px; margin-bottom:44px;
  }
  header.cover .meta{display:flex; justify-content:space-between; align-items:baseline; gap:16px; flex-wrap:wrap}
  header.cover .who{font-size:14px; color:var(--ink-faint)}

  /* ---- the one number ---- */
  .headline{
    background:var(--card); border:1px solid var(--line); border-radius:14px;
    padding:34px 32px; text-align:center; margin-bottom:20px;
  }
  .headline .num{font-size:64px; font-weight:700; letter-spacing:-.03em; line-height:1}
  .headline.behind .num{color:var(--bad)}
  .headline.ahead .num{color:var(--good)}
  .headline .lbl{font-size:19px; margin-top:10px; color:var(--ink)}
  .headline .sub{font-size:15px; color:var(--ink-faint); margin-top:6px}

  /* ---- generic blocks ---- */
  .card{background:var(--card); border:1px solid var(--line); border-radius:12px; padding:20px 22px; margin-bottom:14px}
  /* 300px min gives a clean 2x2 for the four headline stats rather than
     3-across with an orphan on the second row. */
  .grid2{display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:14px}
  .stat{background:var(--card); border:1px solid var(--line); border-radius:12px; padding:18px 20px}
  .stat .v{font-size:27px; font-weight:680; letter-spacing:-.02em}
  .stat .k{font-size:13px; color:var(--ink-faint); margin-top:3px}

  /* ---- where it goes ---- */
  .bar{display:flex; height:34px; border-radius:8px; overflow:hidden; border:1px solid var(--line); margin:18px 0 10px}
  .bar span{display:block}
  .seg-essential{background:#2c5f5a}
  .seg-commitment{background:#4a7c78}
  .seg-sinking{background:#8aa8a3}
  .seg-discretionary{background:#c9a227}
  .seg-unknown{background:#cfc9bd}
  .legend{display:grid; gap:9px; margin-top:14px}
  .legend .row{display:flex; align-items:center; gap:11px; font-size:15px}
  .dot{width:12px; height:12px; border-radius:3px; flex:none}
  .legend .amt{margin-left:auto; font-variant-numeric:tabular-nums; font-weight:600}
  .legend .shr{color:var(--ink-faint); font-size:13px; width:44px; text-align:right; font-variant-numeric:tabular-nums}

  /* ---- findings ---- */
  .finding{border-left:4px solid var(--line); padding:16px 0 16px 18px; margin-bottom:20px}
  .finding.critical{border-color:#9c3a2e}
  .finding.high{border-color:#c07a18}
  .finding.medium{border-color:#c9a227}
  .finding.win{border-color:var(--good)}
  .finding h3{margin-bottom:6px}
  .finding .amt{
    display:inline-block; font-size:12px; font-weight:650; padding:3px 9px;
    border-radius:20px; background:var(--accent-bg); color:var(--accent); margin-bottom:8px;
  }
  .finding .do{
    margin-top:10px; padding:12px 14px; background:var(--accent-bg);
    border-radius:8px; font-size:15px; color:#224a46;
  }
  .finding .do b{color:var(--accent)}
  .finding .ev{font-size:13px; color:var(--ink-faint); margin-top:8px}

  /* ---- plan ---- */
  ol.plan{list-style:none; padding:0; margin:0; counter-reset:step}
  ol.plan li{
    position:relative; padding:0 0 22px 46px; margin:0;
    border-left:2px solid var(--line); margin-left:15px;
  }
  ol.plan li:last-child{border-left-color:transparent}
  ol.plan li::before{
    counter-increment:step; content:counter(step);
    position:absolute; left:-16px; top:-2px; width:30px; height:30px;
    background:var(--card); border:2px solid var(--line); border-radius:50%;
    display:grid; place-items:center; font-size:13px; font-weight:700; color:var(--ink-faint);
  }
  ol.plan li.done::before{content:"✓"; background:var(--good); border-color:var(--good); color:#fff}
  ol.plan li.now::before{border-color:var(--accent); color:var(--accent)}
  ol.plan .t{font-weight:650; margin-bottom:4px}
  ol.plan .w{font-size:15px; color:var(--ink-soft); margin-bottom:6px}
  ol.plan .d{font-size:13px; color:var(--ink-faint)}
  .meter{height:8px; background:var(--line); border-radius:6px; overflow:hidden; margin:8px 0 6px; max-width:320px}
  .meter i{display:block; height:100%; background:var(--good)}

  /* ---- kids ---- */
  .kids{background:#fff8e8; border:2px solid #f0dfb4; border-radius:16px; padding:30px 28px}
  .kids h2{color:#7a5a12}
  .kids p{color:#6b5a37; font-size:17px}
  .thermo{
    height:40px; background:#fff; border:2px solid #e6cf95; border-radius:22px;
    overflow:hidden; margin:20px 0 8px; position:relative;
  }
  .thermo i{display:block; height:100%; background:linear-gradient(90deg,#e8b93d,#2f8f5b); border-radius:20px}
  .thermo b{
    position:absolute; inset:0; display:grid; place-items:center;
    font-size:15px; font-weight:700; color:#3c3222;
  }

  /* ---- tables ---- */
  table{width:100%; border-collapse:collapse; font-size:15px}
  th{text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:.07em;
     color:var(--ink-faint); border-bottom:1.5px solid var(--line); padding:8px 6px}
  td{padding:9px 6px; border-bottom:1px solid var(--line)}
  td.n{text-align:right; font-variant-numeric:tabular-nums}
  tr:last-child td{border-bottom:none}
  .tag{font-size:11px; padding:2px 7px; border-radius:4px; background:var(--line); color:var(--ink-soft)}

  /* ---- notes ---- */
  .note{
    background:var(--warn-bg); border:1px solid #edd9ae; border-radius:10px;
    padding:16px 18px; font-size:14.5px; color:#6b4a12;
  }
  .note b{color:#7a5210}
  .foot{border-top:1px solid var(--line); padding-top:20px; font-size:13px; color:var(--ink-faint)}
  ul.tight{margin:0 0 14px; padding-left:20px; color:var(--ink-soft)}
  ul.tight li{margin-bottom:6px}
  a{color:var(--accent)}

  @media print{
    body{background:#fff}
    .sheet{padding:0; max-width:none}
    section{page-break-inside:avoid}
    .page-break{page-break-before:always}
    .card,.stat,.headline{border-color:#ccc}
  }
</style>
</head>
<body>
<div class="sheet">

  <header class="cover">
    <div class="eyebrow">Family money meeting</div>
    <h1>{{ household_name }}</h1>
    <div class="meta">
      <div class="who">
        {{ generated_fmt }}
        {% if children_ages %} · Tamariki aged {{ children_ages | join(', ') }}{% endif %}
      </div>
      <div class="who">
        Built from {{ stats.transactions }} transactions
        {% if stats.first_date %}({{ stats.first_date }} → {{ stats.last_date }}){% endif %}
      </div>
    </div>
  </header>

  {# ---------------------------------------------------------------- #}
  {# 1. The one number                                                #}
  {# ---------------------------------------------------------------- #}
  <section>
    <div class="headline {{ headline.state }}">
      <div class="num">{{ headline.number or '—' }}</div>
      <div class="lbl">{{ headline.label }}</div>
      <div class="sub">{{ headline.sub }}</div>
    </div>

    {% if typical.available %}
    <div class="grid2">
      <div class="stat">
        <div class="v">{{ typical.income_median | money }}</div>
        <div class="k">Comes in, typical month</div>
      </div>
      <div class="stat">
        <div class="v">{{ typical.spend_median | money }}</div>
        <div class="k">Goes out, typical month</div>
      </div>
      <div class="stat">
        <div class="v">{{ cash.total | money }}</div>
        <div class="k">Cash on hand{% if cash.runway_weeks %} · {{ cash.runway_weeks }} weeks of essentials{% endif %}</div>
      </div>
      <div class="stat">
        <div class="v">{{ mortgage.balance | money }}</div>
        <div class="k">Mortgage remaining</div>
      </div>
    </div>
    <p style="margin-top:14px; font-size:14px; color:var(--ink-faint)">
      "Typical" is the median of {{ typical.month_count }} complete months, not the average —
      so one big month doesn't distort the picture.
      {% if typical.lumpiness and typical.lumpiness > 15 %}
      Spending here is lumpy ({{ typical.lumpiness }}% gap between median and average),
      which usually means big irregular bills rather than day-to-day drift.
      {% endif %}
    </p>
    {% endif %}
  </section>

  {# ---------------------------------------------------------------- #}
  {# 2. What is going well — deliberately before the problems         #}
  {# ---------------------------------------------------------------- #}
  {% if wins %}
  <section>
    <div class="eyebrow">Start here</div>
    <h2>What's already working</h2>
    {% for w in wins %}
    <div class="finding win">
      <h3>{{ w.title }}</h3>
      <p>{{ w.body }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {# ---------------------------------------------------------------- #}
  {# 3. Where the money goes                                          #}
  {# ---------------------------------------------------------------- #}
  {% if groups %}
  <section>
    <h2>Where it goes</h2>
    <p class="lede">A typical month, split by how much choice the household has over each part.</p>
    <div class="bar">
      {% for g in groups %}
      <span class="seg-{{ g.key }}" style="width:{{ g.share }}%" title="{{ g.label }}"></span>
      {% endfor %}
    </div>
    <div class="legend">
      {% for g in groups %}
      <div class="row">
        <span class="dot seg-{{ g.key }}"></span>
        <span>{{ g.label }}</span>
        <span class="amt">{{ g.amount_fmt }}</span>
        <span class="shr">{{ g.share }}%</span>
      </div>
      {% endfor %}
    </div>

    {% if categories %}
    <h3 style="margin-top:32px">Biggest categories</h3>
    <table>
      <thead>
        <tr><th>Category</th><th class="n">Per month</th><th class="n">Per year</th><th class="n">Share</th></tr>
      </thead>
      <tbody>
        {% for c in categories %}
        <tr>
          <td>{{ c.label }}{% if c.flagged %} <span class="tag">worth discussing</span>{% endif %}</td>
          <td class="n">{{ c.per_month | money }}</td>
          <td class="n">{{ c.per_year | money }}</td>
          <td class="n">{{ c.share_pct }}%</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if not coverage.trustworthy %}
    <div class="note" style="margin-top:18px">
      <b>Read these with caution.</b> Only {{ coverage.categorised_pct }}% of spending is
      categorised, so {{ coverage.uncategorised_spend | money }} is sitting in "unknown".
      The shape of this chart will change once that's sorted.
    </div>
    {% endif %}
  </section>
  {% endif %}

  {# ---------------------------------------------------------------- #}
  {# 4. What's worth doing                                            #}
  {# ---------------------------------------------------------------- #}
  <section class="page-break">
    <div class="eyebrow">The short list</div>
    <h2>What's worth doing</h2>
    <p class="lede">Ordered by what it's worth against how hard it is. Pick two.</p>
    {% for f in actions %}
    <div class="finding {{ f.severity }}">
      {% if f.amount %}<div class="amt">{{ f.amount | money }} {{ f.unit }}</div>{% endif %}
      <h3>{{ f.title }}</h3>
      <p>{{ f.body }}</p>
      {% if f.action %}<div class="do"><b>Do this:</b> {{ f.action }}</div>{% endif %}
      {% if f.evidence %}<div class="ev">{{ f.evidence }}</div>{% endif %}
    </div>
    {% endfor %}
  </section>

  {# ---------------------------------------------------------------- #}
  {# 5. The plan                                                      #}
  {# ---------------------------------------------------------------- #}
  <section>
    <h2>The order to do it in</h2>
    <p class="lede">
      Sequence matters more than content. Each step makes the next one possible —
      and doing them out of order is how good intentions turn into debt.
    </p>
    <ol class="plan">
      {% for step in plan %}
      <li class="{{ 'done' if step.status == 'done' else ('now' if step.status == 'in progress' else '') }}">
        <div class="t">{{ step.title }}</div>
        <div class="w">{{ step.why }}</div>
        {% if step.progress_pct is defined and step.progress_pct %}
        <div class="meter"><i style="width:{{ step.progress_pct }}%"></i></div>
        <div class="d">{{ step.progress_pct }}% there</div>
        {% endif %}
        <div class="d">Done when: {{ step.done_when }}</div>
      </li>
      {% endfor %}
    </ol>
  </section>

  {# ---------------------------------------------------------------- #}
  {# 6. Entitlements                                                  #}
  {# ---------------------------------------------------------------- #}
  {% if entitlements.available %}
  <section class="page-break">
    <div class="eyebrow">Money you may already be entitled to</div>
    <h2>Worth an hour at the kitchen table</h2>

    {% if entitlements.headline %}
    <div class="card"><p style="margin:0">{{ entitlements.headline }}</p></div>
    {% endif %}

    <div class="grid2">
      <div class="stat">
        <div class="v">{{ entitlements.received_annualised | money }}</div>
        <div class="k">Actually received in the last year (from your bank data)</div>
      </div>
      <div class="stat">
        <div class="v">{{ entitlements.total_estimate_annual | money }}</div>
        <div class="k">Rough estimate for a household this shape</div>
      </div>
    </div>

    <div class="note" style="margin-top:16px">
      <b>Treat the estimate as a prompt, not a promise.</b>
      {% for c in entitlements.caveats %}{{ c }} {% endfor %}
      The authoritative answer is IRD's own calculator:
      <a href="{{ entitlements.calculator_url }}">{{ entitlements.calculator_url }}</a>
    </div>

    {% if checklist %}
    <h3 style="margin-top:28px">Also worth checking</h3>
    <p>These depend on circumstances this tool can't see, so they're prompts rather than calculations.</p>
    <table>
      <thead><tr><th>Support</th><th>Who it's for</th></tr></thead>
      <tbody>
        {% for item in checklist %}
        <tr>
          <td><b>{{ item.name }}</b></td>
          <td>{{ item.applies_to }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </section>
  {% endif %}

  {# ---------------------------------------------------------------- #}
  {# 7. Regular commitments                                           #}
  {# ---------------------------------------------------------------- #}
  {% if recurring.items %}
  <section>
    <h2>Everything that repeats</h2>
    <p class="lede">
      {{ recurring.count }} regular payments totalling
      <b>{{ recurring.total_monthly | money }} a month</b>.
      Nobody decides these each month — which is exactly why they're worth reading aloud once a year.
    </p>
    <table>
      <thead>
        <tr><th>What</th><th>How often</th><th class="n">Each time</th><th class="n">Per year</th></tr>
      </thead>
      <tbody>
        {% for r in recurring["items"][:18] %}
        <tr>
          <td>
            {{ r.merchant | title }}
            {% if r.possibly_cancelled %}<span class="tag">may have stopped</span>{% endif %}
          </td>
          <td>{{ r.cadence }}</td>
          <td class="n">{{ r.typical_amount | money(2) }}</td>
          <td class="n">{{ r.annual_cost | money }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# ---------------------------------------------------------------- #}
  {# 8. The kids' page                                                #}
  {# ---------------------------------------------------------------- #}
  {% if goal %}
  <section class="page-break">
    <div class="kids">
      <div class="eyebrow" style="color:#a8873c">For the whole whānau</div>
      <h2>{{ goal.title }}</h2>
      <p>{{ goal.explain }}</p>
      <div class="thermo">
        <i style="width:{{ goal.progress }}%"></i>
        <b>{{ goal.progress }}% of the way there</b>
      </div>
      <p style="font-size:15px; margin-top:14px">
        Every time we fill this up a bit more, our family gets a bit safer.
        That's the whole game — and everyone helps, even in small ways.
      </p>
      <h3 style="margin-top:24px; color:#7a5a12">Three things we're trying this month</h3>
      <ul class="tight" style="color:#6b5a37">
        <li>Pick one thing we'll do at home instead of buying.</li>
        <li>Notice one thing we already have that we're grateful for.</li>
        <li>Put something — anything — into the safety net jar.</li>
      </ul>
    </div>
  </section>
  {% endif %}

  {# ---------------------------------------------------------------- #}
  {# 9. Progress since last meeting                                   #}
  {# ---------------------------------------------------------------- #}
  <section>
    <h2>Progress</h2>
    {% if progress %}
    <p class="lede">Compared with the snapshot taken {{ progress.since }}.</p>
    <table>
      <thead><tr><th>Measure</th><th class="n">Then</th><th class="n">Now</th><th class="n">Change</th></tr></thead>
      <tbody>
        {% for label, d in [('Left over each month', progress.net), ('Spending each month', progress.spend), ('Cash on hand', progress.cash), ('Weeks of runway', progress.runway)] %}
        {% if d %}
        <tr>
          <td>{{ label }}</td>
          <td class="n">{{ d["from"] | money }}</td>
          <td class="n">{{ d["to"] | money }}</td>
          <td class="n">{{ d.change | money }}</td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="lede">
      This is the first snapshot, so there's nothing to compare against yet.
      Take one at the end of every family meeting and this page becomes the
      most useful one in the report.
    </p>
    {% endif %}

    {% if monthly %}
    <h3 style="margin-top:28px">Month by month</h3>
    <table>
      <thead><tr><th>Month</th><th class="n">In</th><th class="n">Out</th><th class="n">Left over</th></tr></thead>
      <tbody>
        {% for m in monthly %}
        <tr>
          <td>{{ m.month }}</td>
          <td class="n">{{ m.income | money }}</td>
          <td class="n">{{ m.spend | money }}</td>
          <td class="n" style="color:{{ '#2f6f4e' if m.net >= 0 else '#9c3a2e' }}">{{ m.net | money }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p style="font-size:13px; color:var(--ink-faint)">
      First and last months are often partial — they reflect where the bank export starts and stops.
    </p>
    {% endif %}
  </section>

  {# ---------------------------------------------------------------- #}
  {# 10. Small print                                                  #}
  {# ---------------------------------------------------------------- #}
  <section class="foot">
    <p><b>Built with Wyrmhoard</b> — free and open source, and it runs entirely
      on your own machine.</p>
    <p><b>How this was made.</b>
      Every figure comes from {{ household_name }}'s own bank exports, processed on your
      own machine. Nothing was uploaded anywhere.
      {{ coverage.categorised_pct }}% of spending is categorised across
      {{ stats.transactions }} transactions.</p>
    <p>{{ disclaimer }}</p>
    {% if rates_unverified %}
    <p><b>Unverified rates:</b> {{ rates_unverified | join(', ') }}.
      These were seeded from a language model and haven't been checked against IRD
      for the current tax year. Any entitlement figure above is a rough signal only.
      Verifying them in <code>config/nz_rates.yml</code> takes about ten minutes.</p>
    {% endif %}
  </section>

</div>
</body>
</html>
