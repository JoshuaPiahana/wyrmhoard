#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Wyrmhoard - thin wrapper so the monthly routine is two short commands rather than
# two long ones. Works from Linux, WSL, or Git Bash on Windows:  ./hoard ingest
#
# No `make` dependency on purpose; Ubuntu images do not always ship it, and a
# routine that fails on a missing tool is a routine that gets abandoned.
# ---------------------------------------------------------------------------
set -euo pipefail
cd "$(dirname "$0")"

# Git Bash rewrites anything that looks like a Unix path before handing it to a
# native Windows binary, so `-v "$PWD:/repo"` reached docker as a mangled pair
# and the mount silently did not happen. The tests that need the repo root then
# skipped themselves - passing, in the sense that nothing failed, while two
# guards quietly stopped running. Turning the rewriting off is the documented
# fix, and it is a no-op everywhere else.
case "${OSTYPE:-}" in
  msys* | cygwin*) export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' ;;
esac

run() { docker compose run --rm --no-deps api python -m wyrmhoard.cli "$@"; }

if ! docker info >/dev/null 2>&1; then
  echo "Docker is not running. Start Docker Desktop, or in WSL: sudo service docker start" >&2
  exit 1
fi

cmd="${1:-help}"
shift || true

case "$cmd" in
  up)       docker compose up -d && echo "Dashboard: http://localhost:8080" ;;
  down)     docker compose down ;;
  restart)  docker compose restart ;;
  logs)     docker compose logs -f api ;;
  build)    docker compose build ;;
  # The repo root is mounted at /repo so tests that assert on project files
  # (the e2e isolation guard, for one) can find them here as well as in CI.
  test)     docker compose run --rm --no-deps -v "$PWD:/repo" api python -m pytest tests/ /repo/producers /repo/consumers -q "$@" ;;
  lint)
    # Both linters always run, even if the first fails - seeing every problem
    # at once beats fixing Python, re-running, and only then learning the JS
    # was broken too.
    rc=0
    docker compose run --rm --no-deps -v "$PWD:/repo" -w /repo api bash scripts/lint.sh || rc=1
    echo
    echo "=== eslint (dashboard JS) ==="
    if docker compose run --rm lint-js; then
      echo "eslint passed."
    else
      rc=1
    fi
    if [ "$rc" -ne 0 ]; then
      echo "Static checks FAILED." >&2
    fi
    exit "$rc"
    ;;
  fmt)      docker compose run --rm --no-deps -v "$PWD:/repo" -w /repo api sh -c "ruff check --fix . ; ruff format ." ;;
  mcp-http)
    docker compose --profile mcp-http up -d mcp-http
    echo "MCP server on http://localhost:8787/mcp (this machine only)"
    ;;
  mcp-http-stop)
    docker compose --profile mcp-http down
    ;;

  e2e)
    # Its own project name, its own throwaway data volumes, no host ports.
    # The tests must never be able to reach the household's real ledger.
    E2E="docker compose -p wyrmhoard-e2e -f docker-compose.yml -f docker-compose.e2e.yml"
    trap '$E2E down -v >/dev/null 2>&1' EXIT
    $E2E up -d --build api web
    $E2E run --rm --no-deps api python -m wyrmhoard.cli sample
    $E2E run --rm --no-deps api python -m wyrmhoard.cli ingest --sample
    $E2E run --rm e2e "$@"
    ;;
  check)    "$0" lint && "$0" test && "$0" e2e ;;
  shell)    docker compose run --rm --no-deps api bash ;;

  # A lens is a consumer under consumers/<name>/ that reads the API and writes
  # reports/lenses/<name>.json for the dashboard's Lens tab. It runs in the api
  # image only because that image has a Python; it imports nothing from the
  # core and talks to it over HTTP like any other client. Needs `./hoard up`
  # first - the run joins the compose network, where `api` resolves.
  lens)
    name="${1:?usage: ./hoard lens <name> [args]   (the lenses are the directories under consumers/ with a lens.yml)}"
    shift || true
    if [ ! -f "consumers/$name/lens.yml" ]; then
      echo "No lens called '$name'. Available:" >&2
      for d in consumers/*/lens.yml; do echo "  $(basename "$(dirname "$d")")" >&2; done
      exit 1
    fi
    mkdir -p reports/lenses
    docker compose run --rm --no-deps -T \
      -v "$PWD/consumers:/consumers:ro" -v "$PWD/reports:/reports" \
      -w "/consumers/$name" api python "$name.py" --api http://api:8000 --out /reports/lenses "$@"
    ;;

  # Everything else is a CLI subcommand.
  ingest|sample|summary|review|recategorise|note|notes|loan|init|reset)
            run "$cmd" "$@" ;;

  help|--help|-h)
    cat <<'USAGE'
Wyrmhoard - household finance

  ./hoard up                 start the dashboard at http://localhost:8080
  ./hoard down               stop everything
  ./hoard logs               tail the API logs

  ./hoard sample             generate synthetic data to try it out
  ./hoard ingest             import every CSV in data/inbox/
  ./hoard ingest --sample    import the synthetic sample
  ./hoard review             biggest uncategorised spending
  ./hoard recategorise       re-apply rules after editing config/rules.yml
  ./hoard summary            headline numbers in the terminal
  ./hoard note "..."         write down what happened this month
  ./hoard notes              what you have said about past months
  ./hoard loan               mortgage payoff scenarios
  ./hoard lens babylon       read the figures through a lens; shows on the Lens tab

  ./hoard lint               static analysis: data guard, ruff, mypy
  ./hoard fmt                auto-fix lint and formatting
  ./hoard test               unit and integration tests
  ./hoard e2e                browser tests against the running stack
  ./hoard check              all of the above, in the order CI runs them
  ./hoard build              rebuild the image after changing dependencies

The monthly routine is:   ./hoard ingest && ./hoard lens babylon   (./hoard summary for the terminal)
USAGE
    ;;
  *) echo "Unknown command: $cmd. Try ./hoard help" >&2; exit 1 ;;
esac
